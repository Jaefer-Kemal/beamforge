{erl_opts, [
    debug_info,
    warnings_as_errors,
    warn_export_all,
    warn_export_vars,
    warn_shadow_vars,
    warn_obsolete_guard
]}.

{deps, []}.

{project_app_dirs, ["apps/*"]}.

{relx, [
    {release, {bf_harness, "0.1.0"}, [
        sasl,
        bf_grader,
        bf_tracer,
        bf_xmpp_sim
    ]},
    {mode, dev},
    {sys_config, "./config/sys.config"},
    {vm_args, "./config/vm.args"}
]}.

{profiles, [
    {test, [
        {erl_opts, [nowarn_export_all, debug_info]}
    ]}
]}.
